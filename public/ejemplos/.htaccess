# Webs de ejemplo (vistas previas del portafolio): páginas de demostración, no indexables y con su propia política de seguridad.
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set X-Frame-Options "SAMEORIGIN"
  # Mismo origen para todo; los scripts y estilos de la demo son locales (sin inline en scripts, sin terceros).
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'none'; object-src 'none'"
  # Estas webs se actualizan a menudo con los mismos nombres de archivo: el navegador siempre revalida (304 si no cambió, no se vuelve a descargar).
  # Solo las tipografías (que no cambian) se guardan 30 días.
  <FilesMatch "\.(html|js|css|jpg|png)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
