# Conexión a PostgreSQL (puede ser el Postgres de tu proyecto Supabase: Project Settings -> Database -> Connection string)
DATABASE_URL="postgresql://USUARIO:CONTRASENA@HOST:5432/postgres?schema=public"

# Origen de datos del panel: "mock" (datos de ejemplo en el navegador) o "prisma" (PostgreSQL real, pendiente de conectar)
NEXT_PUBLIC_DATA_SOURCE="mock"
